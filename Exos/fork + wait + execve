#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <sys/types.h>

/**
 * main - Executes "ls -l /tmp" in 5 child processes sequentially
 * Description: Each child is created, runs ls, and the parent waits
 *              before creating the next child
 * Return: 0 on success, 1 on error
 */
int main(void)
{
	pid_t pid;
	int i;
	char *argv[] = {"ls", "-l", "/tmp", NULL};
	char *env[] = {NULL};
	
	for (i = 0; i < 5; i++)
	{
		pid = fork();
		
		if (pid == -1)
		{
			perror("fork");
			return (1);
		}
		
		if (pid == 0)
		{
			/* Child process: execute ls -l /tmp */
			execve("/bin/ls", argv, env);
			/* If execve returns, there was an error */
			perror("execve");
			return (1);
		}
		else
		{
			/* Parent process: wait for child to finish */
			wait(NULL);
			printf("Child %d completed\n", i + 1);
		}
	}
	
	return (0);
}
